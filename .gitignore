node_modules
dist

# Input videos are large; keep them out of git (folder itself is kept via .gitkeep)
data/*
!data/.gitkeep
# Annotated videos in results are large; JSON/CSV results are tracked
results/**/*.mp4
results/**/*.webm
# Model weights are large (ViTPose is 344 MB); fetch them with `npm run models`
public/models/*
!public/models/yolo11n-pose.onnx
