{
  // Browser app (src/). Type-check with `npm run typecheck`; Vite only strips types.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true, // src/sync/ uses .ts imports so Node can run it too (scripts/sync.ts)
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
